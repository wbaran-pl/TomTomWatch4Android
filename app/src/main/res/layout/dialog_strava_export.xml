<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Strava Upload Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity Name (Optional)"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/edit_strava_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Leave empty for Strava default"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description (Optional)"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/edit_strava_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Leave empty for none"
            android:inputType="textMultiLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="External ID"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/edit_strava_external_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="External ID"
            android:inputType="text"
            android:enabled="false" />

        <CheckBox
            android:id="@+id/check_strava_trainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trainer" />

        <CheckBox
            android:id="@+id/check_strava_commute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Commute" />

        <CheckBox
            android:id="@+id/check_strava_gzip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gzip Data (upload as .gpx.gz)"
            android:checked="true" />

    </LinearLayout>
</ScrollView>
